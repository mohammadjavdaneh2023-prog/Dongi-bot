# Required: deployment environment name (development, test, production).
APP_ENV=development
# Required: immutable release or commit identifier.
APP_VERSION=dev
# Required: PostgreSQL connection URL for DONGI's dedicated database/user.
DATABASE_URL=postgresql://dongi:change-me@postgres:5432/dongi
# Required: 64 hexadecimal characters; set only as a host secret in production.
APP_ENCRYPTION_KEY=
# Required: token of the newly created Telegram Bot.
TELEGRAM_BOT_TOKEN=
# Required only for initial bootstrap: Telegram numeric ID of the new Owner.
OWNER_TELEGRAM_ID=
# Required only for initial bootstrap: display name of the new Owner.
OWNER_NAME=
# Optional: stable public ID for the Owner, for example AA111.
OWNER_PUBLIC_ID=
# Optional: invitation validity in seconds; defaults to 86400.
DONGI_GRANT_TTL_SECONDS=86400
# Optional: DEBUG, INFO, WARN, or ERROR; defaults to INFO.
LOG_LEVEL=INFO
# Optional: health HTTP port; defaults to 3000.
PORT=3000
# Optional: IANA timezone; defaults to Asia/Tehran.
DEFAULT_TIMEZONE=Asia/Tehran
# Required only for integration tests; points to an expendable PostgreSQL database.
TEST_DATABASE_URL=postgresql://dongi_test:change-me@localhost:5432/dongi_test
# Required only by backup/restore operator scripts; never reuse APP_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=
# Optional backup output directory; defaults to ./backups and must remain outside Git.
BACKUP_OUTPUT=./backups
