{
  "name": "dongi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "check:setup": "node --env-file-if-exists=.env scripts/check-setup.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/**/*.test.js",
    "start": "node --env-file-if-exists=.env scripts/start.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "check": "node scripts/check.js",
    "format:check": "node scripts/format-check.js",
    "typecheck": "node scripts/check.js",
    "bootstrap-owner": "node --env-file-if-exists=.env scripts/bootstrap-owner.js",
    "verify:secrets": "node scripts/verify-repository.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
